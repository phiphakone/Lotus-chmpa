rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() {
   return signedIn() && (request.auth.uid == 'fmkw0LyA8yWYYZBbePmDx3g5JWE2' || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true));
  }
  function validItem(i) {
   return i.keys().hasOnly(['id','name','price','qty','image'])
    && i.id.matches('[\\s\\S]{1,100}') && i.name.matches('[\\s\\S]{1,300}')
    && i.price > 0 && i.price <= 100000000000
    && i.qty is int && i.qty > 0 && i.qty <= 999
    && i.image.size() <= 2000 && (i.image == '' || i.image.matches('https?://.*|images/.*'));
  }
  function validItems(items) {
   let n = items.size();
   return n > 0 && n <= 5
    && validItem(items[0])
    && (n <= 1 || validItem(items[1]))
    && (n <= 2 || validItem(items[2]))
    && (n <= 3 || validItem(items[3]))
    && (n <= 4 || validItem(items[4]));
  }
  function subtotal(items) {
   let zero = {'price':0,'qty':0};
   let p = items.concat([zero,zero,zero,zero,zero]);
   return p[0].price*p[0].qty + p[1].price*p[1].qty + p[2].price*p[2].qty + p[3].price*p[3].qty + p[4].price*p[4].qty;
  }
  function validCustomer(c,o) {
   return c.keys().hasOnly(['name','phone','addr','email','city','country','note'])
    && c.name == o.name && c.phone == o.phone && c.addr == o.address
    && c.email.matches('[\\s\\S]{0,254}') && c.city.matches('[\\s\\S]{0,150}')
    && c.country.matches('[\\s\\S]{0,100}') && c.note is string && c.note.size() <= 2000;
  }
  function validSlip(o) {
   return (o.payMethod in ['cod','card'] && o.slipUrl == '' && o.slipPath == '' && o.slipName == '' && o.slipType == '' && o.slipSize == 0 && o.slipUploadedAt == null)
    || (o.payMethod in ['bank-vn','bcel','qr']
     && o.slipUrl.matches('https://firebasestorage[.]googleapis[.]com/v0/b/lotus-1a491[.]firebasestorage[.]app/o/.+') && o.slipUrl.size() <= 2000
     && o.slipPath.matches('payment-slips/' + request.auth.uid + '/[^/]{1,400}')
     && o.slipName.matches('[\\s\\S]{1,255}')
     && o.slipType in ['image/jpeg','image/png','image/webp','image/gif']
     && o.slipSize is int && o.slipSize > 0 && o.slipSize <= 8*1024*1024
     && o.slipUploadedAt.matches('[\\s\\S]{1,50}'));
  }
  function validOrder(o) {
   return o.keys().hasOnly(['ownerUid','name','phone','address','customer','items','subtotal','shipFee','discount','total','shipMethod','payMethod','coupon','status','paymentStatus','slipUrl','slipPath','slipName','slipType','slipSize','slipUploadedAt','createdAt'])
    && o.ownerUid == request.auth.uid && o.createdAt == request.time
    && o.name.matches('[\\s\\S]{1,150}') && o.phone.matches('[\\s\\S]{3,40}') && o.address.matches('[\\s\\S]{1,1000}')
    && validCustomer(o.customer,o) && validItems(o.items)
    && o.subtotal > 0 && o.subtotal <= 100000000000 && o.subtotal == subtotal(o.items)
    && o.shipFee >= 0 && o.shipFee <= 100000000000
    && o.discount >= 0 && o.discount <= o.subtotal
    && o.total <= 100000000000 && o.total == o.subtotal - o.discount + o.shipFee
    && o.shipMethod in ['vn','lao','pickup','contact']
    && (o.coupon == null || o.coupon.matches('[\\s\\S]{1,100}'))
    && o.status == 'pending' && o.paymentStatus == 'pending' && validSlip(o);
  }
  match /orders/{orderId} {
   allow create: if signedIn() && validOrder(request.resource.data);
   allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
   allow update: if admin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paymentStatus','paymentReviewedAt'])
    && request.resource.data.status in ['pending','confirmed','shipped','completed','cancelled']
    && request.resource.data.paymentStatus in ['pending','paid','rejected']
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentReviewedAt']) || request.resource.data.paymentReviewedAt == request.time);
   allow delete: if admin();
  }
  function validProfile(p,uid) {
   return p.keys().hasOnly(['uid','name','email','phone','createdAt'])
    && p.uid == uid && p.name.matches('[\\s\\S]{1,150}') && p.email == request.auth.token.email
    && p.email.matches('[\\s\\S]{1,254}') && p.phone.matches('[\\s\\S]{0,40}');
  }
  match /users/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || admin());
   allow list: if admin();
   allow create: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data,uid) && request.resource.data.createdAt == request.time;
   allow update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data,uid) && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if admin();
  }
  // Public product data only. Orders, accounts and media configuration stay private.
  function validProduct(p) {
   return p.keys().hasAll(['name','country','cat','price','oldPrice','stock','origin','desc','story','image','deleted','updatedAt'])
    && p.keys().hasOnly(['name','country','cat','price','oldPrice','stock','origin','desc','story','image','deleted','updatedAt'])
    && p.name is string && p.name.size() > 0 && p.name.size() <= 300 && p.name.matches('[^<>]+')
    && p.country in ['lao','vietnam'] && p.cat in ['handcraft','specialty','health']
    && p.price is number && p.price > 0 && p.price <= 100000000000
    && p.oldPrice is number && p.oldPrice >= 0 && p.oldPrice <= 100000000000
    && p.stock is int && p.stock >= 0 && p.stock <= 999999
    && p.origin is string && p.origin.size() <= 300 && p.origin.matches('[^<>]*')
    && p.desc is string && p.desc.size() <= 10000 && p.desc.matches('[^<>]*')
    && p.story is string && p.story.size() <= 20000 && p.story.matches('[^<>]*')
    && p.image is string && p.image.size() <= 2000
    && (p.image.matches('https://[^\\s\"\'<>\\\\`]+') || p.image.matches('images/[a-zA-Z0-9_./-]+'))
    && p.deleted is bool && p.updatedAt == request.time;
  }
  match /products/{productId} {
   allow read: if true;
   allow create, update: if admin() && productId.matches('[a-zA-Z0-9_-]{1,100}') && validProduct(request.resource.data);
   // Use a reversible deleted flag so a seed product cannot accidentally reappear.
   allow delete: if false;
  }
  match /catalogSettings/{settingId} {
   allow get: if admin();
   allow create, update: if admin() && settingId == 'media'
    && request.resource.data.keys().hasOnly(['cloudName'])
    && request.resource.data.cloudName.matches('[a-z0-9_-]{1,100}');
   allow list, delete: if false;
  }
  // Public activity dates; only authenticated administrators may manage them.
  function validActivity(a) {
   return a.keys().hasOnly(['name','date','place','createdAt','updatedAt'])
    && a.name is string && a.name.size() > 0 && a.name.size() <= 120 && a.name.matches('[^<>]+')
    && a.date is string && a.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && a.place is string && a.place.size() <= 120 && a.place.matches('[^<>]*')
    && a.createdAt == request.time && a.updatedAt == request.time;
  }
  match /activities/{activityId} {
   allow read: if true;
   allow create: if admin() && validActivity(request.resource.data);
   allow update: if admin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','date','place','updatedAt'])
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
    && request.resource.data.name.matches('[^<>]+')
    && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && request.resource.data.place is string && request.resource.data.place.size() <= 120
    && request.resource.data.place.matches('[^<>]*') && request.resource.data.updatedAt == request.time;
   allow delete: if admin();
  }
  function validExperienceBooking(b) {
   return b.keys().hasOnly(['ownerUid','type','name','contact','date','guests','status','createdAt'])
    && b.ownerUid == request.auth.uid && b.type in ['food','workshop']
    && b.name is string && b.name.size() > 0 && b.name.size() <= 100 && b.name.matches('[^<>]+')
    && b.contact is string && b.contact.size() >= 3 && b.contact.size() <= 150 && b.contact.matches('[^<>]+')
    && b.date is string && b.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && b.guests is int && b.guests >= 1 && b.guests <= 10
    && b.status == 'pending' && b.createdAt == request.time;
  }
  match /experienceBookings/{bookingId} {
   allow create: if signedIn() && validExperienceBooking(request.resource.data);
   allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
   allow update: if admin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && request.resource.data.status in ['pending','confirmed','cancelled'];
   allow delete: if admin();
  }
  // Role creation remains restricted to trusted Firebase Console/Admin SDK operators.
  match /admins/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
